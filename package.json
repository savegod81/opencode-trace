{
  "name": "opencode-trace-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Monorepo for opencode-trace packages",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:frontend": "turbo run build:frontend",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "node scripts/clean.mjs && turbo run clean",
    "cli": "node packages/cli/dist/index.js",
    "viewer": "node packages/viewer/dist/cli.js",
    "dev": "concurrently \"npm run dev:watch\" \"npm run dev:serve\"",
    "dev:watch": "tsc -b -w",
    "dev:serve": "node --watch packages/viewer/dist/cli.js",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "npm run build && npm run changeset:publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "concurrently": "^9.0.1",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "opencode",
    "trace",
    "monorepo"
  ],
  "license": "MIT"
}
